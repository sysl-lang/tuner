module tuner

// From samples to the pitch a tuner shows: a high-pass filter, a sliding window, a detection every
// hop, a median over the last few answers, a note that does not flicker between neighbours, and a
// hold after the string stops ringing.
//
// **Nothing here knows where the samples come from.** The microphone, a synthesized test tone and a
// unit test all hand over slices of whatever length they happen to have, and every decision below is
// counted in samples rather than in seconds of wall clock — so the same samples give the same answer
// however they were chunked, and a test can run a second of audio in a millisecond.

import sh.sysl.pitch.{Detector, HighPass, Note, cents_from, detector, frequency_of, highpass, note_of}
import sysl.math.{Float, min}
import sysl.slices.sort_by

/** Samples a second, which the microphone is asked for and the detector is built for. */
const RATE: int = 48000

/** The range listened to: below a drop-D guitar's low string and above its highest fretted note. */
const LOWEST: real = 70.0
const HIGHEST: real = 1400.0

/** The samples each detection reads: 43 ms at 48 kHz.
 *
 * YIN needs two periods of the lowest frequency, which at 70 Hz is 1374 samples; the next power of two
 * above that gives every lag at least one whole period to be compared over, with room to spare, and
 * three and a half periods of a low E. A longer window reads a steadier pitch and lags the string by
 * more, and a tuner is read while it is being played.
 */
const WINDOW: usize = 2048

/** New samples between detections: half a window, so 47 readings a second and each sample read twice. */
const HOP: usize = 1024

/** How many of the latest readings the median is taken over. Five outvotes two bad frames, and an
 * interruption one hop long spoils exactly two windows.
 */
const MEDIAN_OF: usize = 5

/** Readings needed before anything is shown, so that one stray frame of noise never names a note. */
const AGREE: usize = 3

/** Where the high-pass filter ahead of the window is cut: a little under a guitar's low E at
 * 82.4 Hz, so the string loses under 3 dB while what lies an octave beneath it loses 24.
 */
const CUTOFF: real = 65.0

/** How deep YIN's dip has to be to count as a period, and how sure a frame has to be — one minus the
 * depth of that dip — for its reading to enter the median.
 *
 * **The YIN paper's 0.12 and a clarity of 0.9 are right for a clean tone and wrong for a real low E.**
 * An unplugged electric guitar recorded through a laptop's microphone (`lowE.s16`, beside the tests)
 * carries rumble below 65 Hz and a resonance at 80 Hz, with its harmonics at 160 and 240, that is
 * louder than the string's own fundamental. The frame repeats at the string's period only roughly, so
 * the dip there is shallow, and under the old values almost nothing in that recording reads as E2.
 * With the filter taking the rumble out and these values letting a shallower dip count, most of the
 * time the string sounds reads E2, and no frame reads an octave out — the tests measure both.
 */
const THRESHOLD: f32 = 0.2
const CLARITY: f32 = 0.8

/** How far, in cents, the pitch has to move from the note shown before another note is shown. Wider
 * than the half-step's own 50, so a string tuned up from 55 cents flat reads as the note it is being
 * tuned to all the way, rather than as the note below it with a plus sign.
 */
const SWITCH: real = 60.0

/** How long the last note stays up after the signal stops: one second, counted in samples. */
const HOLD: usize = 48000

/** The latest readings, and the median of them. */
struct Smoother
    private recent: [MEDIAN_OF]f32
    private count: usize
    private next: usize

    /** Add a reading, displacing the oldest once there are `MEDIAN_OF` of them. */
    push(*self, f: f32)
        self.recent[self.next] = f
        self.next = (self.next + 1) % MEDIAN_OF

        if self.count < MEDIAN_OF then self.count += 1
    end push

    /** The median of the readings held, once there are at least `AGREE` of them. With an even count
     * it is the lower of the middle two, which is a reading somebody's string actually produced.
     */
    value(self) -> Option[f32]
        if self.count < AGREE then return None

        var sorted: [MEDIAN_OF]f32 = self.recent
        var held = sorted[0..<self.count]

        sort_by(held, (a, b) -> a < b)
        Some(held[(self.count - 1) / 2])
    end value

    clear(*self)
        self.count = 0
        self.next = 0
end Smoother

smoother() -> Smoother = Smoother([0.0; MEDIAN_OF], 0, 0)

/** The whole pipeline: feed it samples, read the pitch. */
struct Pipeline
    private detector: Detector[f32]
    private clarity: f32

    // The high-pass filter every sample goes through on its way into the window, and the buffer it
    // filters in, since what a caller hands over is the caller's.
    private filter: HighPass[f32]
    private filtering: bool
    private scratch: []f32

    // The last `WINDOW` samples, as a ring with `at` the oldest, and the same samples laid out in
    // order for the detector.
    private ring: []f32
    private frame: []f32
    private at: usize
    private filled: usize

    // Samples since the last detection, and since the last frame that counted.
    private fresh: usize
    private since: usize

    private smoothed: Smoother
    private detections: usize

    // The note on show, as a MIDI number, and the A4 it is reckoned against.
    private shown: Option[int]
    private a4: real

    /** Hand over samples as they arrive, in chunks of any length, empty ones included. */
    feed(*self, samples: []const f32)
        var from: usize = 0

        while from < samples.len
            val n = min(samples.len - from, self.scratch.len)
            var part = self.scratch[0..<n]

            for j in 0..<n do part[j] = samples[from + j]

            if self.filtering then self.filter.process(part)

            for s in part do self.take(s)

            from += n
    end feed

    private take(*self, s: f32)
        self.ring[self.at] = s
        self.at = (self.at + 1) % WINDOW

        if self.filled < WINDOW then self.filled += 1

        self.fresh += 1
        self.since += 1

        if self.since == HOLD
            self.smoothed.clear()
            self.shown = None

        if self.filled == WINDOW && self.fresh >= HOP then self.detect()
    end take

    private detect(*self)
        self.fresh = 0
        self.detections += 1

        for i in 0..<WINDOW do self.frame[i] = self.ring[(self.at + i) % WINDOW]

        self.detector.detect(self.frame) match
            Ok(Some(e)) ->
                if e.clarity >= self.clarity
                    self.smoothed.push(e.frequency)
                    self.since = 0
            _ -> ()

        self.settle()
    end detect

    // Keep the note on show while the pitch stays within `SWITCH` cents of it; past that, show the
    // nearest note instead.
    private settle(*self)
        self.shown = self.pitch() match
            None -> None
            Some(f) -> self.shown match
                Some(m) if cents_from(f, frequency_of(m, self.a4)).abs() <= SWITCH -> Some(m)
                _ -> note_of(f, self.a4).map(n -> n.midi)
    end settle

    /** The pitch being played, in Hz — the median of the latest readings — or `None` when nothing
     * has been heard for `HOLD` samples.
     */
    pitch(self) -> Option[real] = self.smoothed.value().map(f -> real(f))

    /** The note on show, and how far the pitch sits from it in cents.
     *
     * **It is not always the nearest note.** Once a note is shown it stays until the pitch is more
     * than `SWITCH` cents from it, so a string 55 cents flat of E reads "E −55" rather than flickering
     * over to "D# +45" and back as the string wavers.
     */
    note(self) -> Option[Note[real]]
        val m = self.shown?

        Some(Note(m, cents_from(self.pitch()?, frequency_of(m, self.a4))))
    end note

    /** Reckon notes against A4 = `a4` Hz from the next window on. */
    tune(*self, a4: real)
        self.a4 = a4

    /** How many windows have been read so far — one every `HOP` samples once the first is full. */
    windows(self) -> usize = self.detections
end Pipeline

/** A pipeline with the settings the tuner ships with; the parameters exist so a test can show what
 * each one is for.
 */
pipeline(threshold: f32 = THRESHOLD, clarity: f32 = CLARITY, filtering: bool = true) -> Pipeline
    var d = detector(f32(RATE), f32(LOWEST), f32(HIGHEST)).expect("the range fits the rate")
    d.threshold = threshold

    val hp = highpass(f32(RATE), f32(CUTOFF)).expect("the cutoff fits the rate")

    Pipeline(d, clarity, hp, filtering, [0.0; HOP], [0.0; WINDOW], [0.0; WINDOW], 0, 0, 0, HOLD,
             smoother(), 0, None, 440.0)
end pipeline
