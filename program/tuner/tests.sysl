module tuner
@tests

import sh.sysl.pitch.{Note, cents_from, rms}
import sysl.fs.read_bytes
import sysl.math.{Float, max, min}
import sysl.path.{join, parent}
import sysl.rand.rng

// What the pipeline claims, run by `sysl test program`.
//
// **Every tone is synthesized from a frequency chosen in advance**, so each reading is checked against
// the number the signal was built from. A tone carries three harmonics rather than being a bare sine,
// the way a string does.

private const rate: real = 48000.0

// The six open strings of a guitar in standard tuning, low E to high E, with their MIDI numbers.
private strings() -> [6]real = [82.4069, 110.0, 146.8324, 195.9977, 246.9417, 329.6276]
private midis() -> [6]int = [40, 45, 50, 55, 59, 64]

// `n` samples of a tone starting at sample `from`, so consecutive calls continue one waveform.
private tone(frequency: real, n: usize, from: usize = 0) -> []f32
    var out: []f32 = [0.0; n]
    val step = 2.0 * real.pi() * frequency / rate

    for j in 0..<n
        val t = step * real(from + j)
        out[j] = f32(0.3 * t.sin() + 0.15 * (2.0 * t).sin() + 0.08 * (3.0 * t).sin())

    out
end tone

private silence(n: usize) -> []f32 = [0.0; n]

private seconds(s: real) -> usize = usize(s * rate)

private heard(t: Pipeline) -> Note[real] = t.note().expect("a note")

// The low E of the user's own guitar — an unplugged electric through a MacBook's microphone — as
// 48 kHz mono signed 16-bit little-endian samples, read from beside this file wherever the suite is
// run from.
private recording() -> []f32
    val dir = parent(__FILE__).expect("this file is in a directory")
    val bytes = read_bytes(join(dir, "lowE.s16")).expect("the fixture is beside the tests")
    var out: []f32 = [0.0; bytes.len / 2]

    for i in 0..<out.len
        val v = int(bytes[2 * i]) | int(bytes[2 * i + 1]) << 8

        out[i] = f32(real(if v >= 32768 then v - 65536 else v) / 32768.0)

    out
end recording

// What a tuner showed over a recording fed to it in chunks of 480 samples — ten milliseconds, a
// typical device buffer — counted chunk by chunk over the chunks where the string is sounding.
private struct Showing
    sounding: usize
    e2: usize
    wrong: usize          // a note shown that is not E2
    least: real           // the extremes of the cents shown with E2
    most: real

private watch(t: *Pipeline, samples: []const f32) -> Showing
    var s = Showing(0, 0, 0, 1000.0, -1000.0)
    var from: usize = 0

    while from < samples.len
        val to = min(from + 480, samples.len)
        val chunk = samples[from..<to]

        t.feed(chunk)
        from = to

        if rms(chunk) >= LOUD
            s.sounding += 1

            t.note() match
                Some(n) if n.midi == 40 ->
                    s.e2 += 1
                    s.least = min(s.least, n.cents)
                    s.most = max(s.most, n.cents)
                Some(_) -> s.wrong += 1
                None -> ()

    s
end watch

// Loud enough to be the string rather than the room: about 38 dB below full scale.
private const LOUD: f32 = 0.012

@test
a_real_low_e_reads_as_e2_for_most_of_the_time_it_sounds()
    // Measured: 251 of the 342 sounding chunks show E2 (73%), every one of them between -16.9 and
    // -1.5 cents. The chunks that show nothing are the pluck's first frames, before three readings
    // agree, and the tail where the string has died into the room. Without the filter it is 230,
    // and with the old clarity of 0.9 it is 107, so the floor tells each setting's absence apart.
    var t = pipeline()
    val s = watch(&t, recording())

    assert(s.sounding > 300, f"the string sounds for ${s.sounding} chunks")
    assert(real(s.e2) >= 0.70 * real(s.sounding), f"E2 for ${s.e2} of ${s.sounding} chunks")
    assert(s.wrong == 0, f"another note for ${s.wrong} chunks — D#2, E3, or anything else")
    assert(s.most - s.least < 20.0, f"the cents wandered from ${s.least} to ${s.most}")

@test
the_old_settings_read_nothing_from_the_same_recording()
    // The YIN paper's threshold, a clarity of 0.9 and no filter, which a clean tone satisfies and
    // this recording does not.
    var t = pipeline(0.12, 0.9, false)
    val s = watch(&t, recording())

    assert(s.e2 + s.wrong < s.sounding / 20, f"a note shown for ${s.e2 + s.wrong} of ${s.sounding} chunks")

// A tone carried on from one chunk to the next with no jump in phase as its pitch moves, the way a
// string bent or tuned keeps ringing.
private struct Voice
    phase: real

    // One 480-sample chunk at `frequency` into the pipeline.
    play(*self, t: *Pipeline, frequency: real)
        var out: []f32 = [0.0; 480]
        val step = 2.0 * real.pi() * frequency / rate

        for j in 0..<out.len
            val p = self.phase + step * real(j)
            out[j] = f32(0.3 * p.sin() + 0.15 * (2.0 * p).sin() + 0.08 * (3.0 * p).sin())

        self.phase += step * real(out.len)
        t.feed(out)
    end play
end Voice

private const E2: real = 82.4069

private cents_above(f: real, c: real) -> real = f * (c / 1200.0).exp2()

// The note on show, as a MIDI number, or -1 for none.
private midi(t: Pipeline) -> int = t.note().map(n -> n.midi).unwrap_or(-1)

@test
a_string_fifty_cents_flat_of_e_stays_e()
    // Fifty cents is exactly between E2 and D#2, so without hysteresis the note would flip with every
    // waver. The pitch moves to a fresh point within eight cents of -50 every tenth of a second.
    var t = pipeline()
    var v = Voice(0.0)
    var r = rng(5, 11)
    var jitter = 0.0

    for chunk in 0..<400
        if chunk % 10 == 0 then jitter = 16.0 * r.unit() - 8.0

        v.play(&t, cents_above(E2, -50.0 + jitter))

        if chunk >= 20
            val n = heard(t)
            assert(n.midi == 40, f"chunk $chunk shows ${n.label()} ${n.cents}")

@test
a_glide_from_e_to_f_switches_once_past_sixty_cents()
    var t = pipeline()
    var v = Voice(0.0)
    var switches = 0

    for chunk in 0..<20 do v.play(&t, E2)

    var was = midi(t)
    assert(was == 40, "the glide starts on E2")

    // Up a semitone over two seconds, then held on F2.
    for chunk in 0..<300
        v.play(&t, cents_above(E2, 100.0 * min(real(chunk) / 200.0, 1.0)))

        val now = midi(t)
        if now != was
            switches += 1
            val at = cents_from(t.pitch().expect("a pitch"), E2)
            assert(was == 40 && now == 41, f"switched from $was to $now")
            assert(at > 60.0, f"switched at only $at cents above E2")

        was = now

    assert(switches == 1, f"switched $switches times")

@test
switching_back_takes_sixty_cents_the_other_way()
    var t = pipeline()
    var v = Voice(0.0)
    val f2 = cents_above(E2, 100.0)

    for chunk in 0..<20 do v.play(&t, f2)

    assert(midi(t) == 41, "it starts on F2")

    // Down to 45 cents above E2 — 55 below F, nearer E — and held there: still F2.
    for chunk in 0..<200
        v.play(&t, cents_above(E2, 100.0 - 55.0 * min(real(chunk) / 100.0, 1.0)))
        assert(midi(t) == 41, f"chunk $chunk shows ${heard(t).label()} ${heard(t).cents}")

    // On down to 30 above E2: E2 comes back once the pitch is more than 60 cents below F.
    var back = false

    for chunk in 0..<200
        v.play(&t, cents_above(E2, 45.0 - 15.0 * min(real(chunk) / 100.0, 1.0)))

        if !back && midi(t) == 40
            back = true
            val at = cents_from(t.pitch().expect("a pitch"), f2)
            assert(at < -60.0, f"switched back at only $at cents below F2")

    assert(back, "E2 came back")

@test
a_steady_tone_at_each_open_string_reads_its_note_within_a_cent()
    for i in 0..<6
        var t = pipeline()
        t.feed(tone(strings()[i], seconds(0.5)))

        val n = heard(t)
        assert(n.midi == midis()[i], f"${strings()[i]} Hz reads as ${n.label()}")
        assert(n.cents.abs() < 1.0, f"${strings()[i]} Hz reads ${n.cents} cents off")

@test
a_tone_ten_cents_sharp_reads_plus_ten()
    var t = pipeline()
    t.feed(tone(110.0 * (10.0 / 1200.0).exp2(), seconds(0.5)))

    val n = heard(t)
    assert(n.label() == "A2", f"reads as ${n.label()}")
    assert((n.cents - 10.0).abs() < 1.0, f"reads ${n.cents} cents")

@test
the_reference_pitch_moves_the_cents()
    var t = pipeline()
    t.tune(442.0)
    t.feed(tone(110.0, seconds(0.5)))

    // A2 against A4 = 442 Hz is 110.5 Hz, so a 110 Hz string is flat by 1200 log2(110.5 / 110).
    val n = heard(t)
    assert(n.label() == "A2", f"reads as ${n.label()}")
    assert((n.cents - cents_from(110.0, 110.5)).abs() < 1.0, f"reads ${n.cents} cents")

@test
silence_says_play_a_string()
    var t = pipeline()
    t.feed(silence(seconds(1.0)))

    assert(t.pitch().is_none(), "silence has no pitch")
    assert(t.windows() > 40, "and it was listened to")

@test
nothing_is_shown_until_three_windows_agree()
    var t = pipeline()
    t.feed(tone(110.0, WINDOW + 1 * HOP))
    assert(t.pitch().is_none(), "two readings are not enough")

    t.feed(tone(110.0, HOP, WINDOW + HOP))
    assert(t.pitch().is_some(), "three are")

@test
a_tone_that_stops_is_held_and_then_cleared()
    var t = pipeline()
    t.feed(tone(110.0, seconds(0.5)))
    t.feed(silence(seconds(0.95)))
    assert(t.note().map(n -> n.label()) == Some("A2"), "still held 0.95 s after the string stopped")

    // The last window holding any of the tone ends at most one window after it stopped.
    t.feed(silence(seconds(0.15)))
    assert(t.pitch().is_none(), "cleared 1.1 s after the string stopped")

@test
a_new_note_after_the_hold_starts_afresh()
    var t = pipeline()
    t.feed(tone(110.0, seconds(0.5)))
    t.feed(silence(seconds(1.5)))
    t.feed(tone(146.8324, WINDOW + 4 * HOP))

    assert(heard(t).label() == "D3", "the new string, with nothing of the old one left in the median")

@test
the_median_takes_the_middle_reading()
    var s = smoother()
    for f in [110.0, 109.0, 330.0, 111.0, 55.0] do s.push(f32(f))

    assert(s.value() == Some(f32(110.0)), f"the median is ${s.value()}")

@test
the_median_keeps_only_the_latest_five()
    var s = smoother()
    for f in [500.0, 500.0, 500.0, 110.0, 110.0, 110.0] do s.push(f32(f))

    assert(s.value() == Some(f32(110.0)), "three of the five held are 110")

@test
the_median_rejects_a_burst_of_another_pitch()
    // Two hops of 196 Hz in the middle of a steady A: one window hears only the G and those either
    // side of it hear a mixture, and the shown pitch never moves from A2.
    var t = pipeline()
    var at: usize = 0

    for hop in 0..<40
        val f = if hop == 20 || hop == 21 then 196.0 else 110.0
        t.feed(tone(f, HOP, at))
        at += HOP

        if hop >= 4
            val n = heard(t)
            assert(n.label() == "A2" && n.cents.abs() < 1.0,
                   f"after hop $hop the tuner shows ${n.label()} ${n.cents}")

@test
one_window_is_read_every_hop()
    var t = pipeline()
    t.feed(silence(WINDOW - 1))
    assert(t.windows() == 0, "nothing is read before the window is full")

    t.feed(silence(1 + 10 * HOP))
    assert(t.windows() == 11, f"read ${t.windows()} windows")

@test
chunked_delivery_reads_exactly_what_one_chunk_reads()
    val signal = tone(196.5, seconds(1.0))
    var whole = pipeline()
    whole.feed(signal)

    var r = rng(17, 3)
    var chunked = pipeline()
    var at: usize = 0
    var k = 0

    // Every fourth chunk is empty, which is what a frame with nothing new recorded hands over.
    while at < signal.len
        val n = if k % 4 == 0 then 0 else usize(r.below(3000))
        val stop = if at + n > signal.len then signal.len else at + n

        chunked.feed(signal[at..<stop])
        at = stop
        k += 1

    assert(chunked.windows() == whole.windows(), "the same windows were read")
    assert(chunked.pitch() == whole.pitch(), f"${chunked.pitch()} against ${whole.pitch()}")

// A plucked high E — five partials — over a quieter A string ringing in sympathy a twelfth below it
// (E4 is A2's third harmonic), under white noise. The A's period is three of E4's, so the frame also
// repeats every three periods, and with noise lifting the dips the first one under the threshold can
// be the deeper one at three periods. That read A2 on the phone.
private const HISS: real = 0.37

private ringing_e4(n: usize, seed: int) -> []f32
    val frequency = strings()[5]
    val amplitudes = [1.0, 0.6, 0.3, 0.15, 0.08]
    val phases = [0.3, 1.9, 4.1, 0.7, 2.6]
    var out: []f32 = [0.0; n]
    var r = rng(u64(seed), 11)

    for h in 0..<amplitudes.len
        val k = real(h + 1)
        val step = 2.0 * real.pi() * k * frequency * (1.0 + 0.0001 * k * k).sqrt() / rate

        for j in 0..<n do out[j] += f32(0.3 * amplitudes[h] * (step * real(j) + phases[h]).sin())

    val below = 2.0 * real.pi() * frequency / 3.0 / rate

    for j in 0..<n do out[j] += f32(0.09 * (below * real(j) + 1.1).sin() + HISS * (r.unit() - 0.5))

    out
end ringing_e4

@test
a_high_e_over_the_a_string_ringing_under_it_shows_e4_and_never_a2_or_e2()
    for seed in 1..<5
        var t = pipeline()
        val signal = ringing_e4(seconds(1.0), seed)
        var shown: usize = 0
        var from: usize = 0

        while from < signal.len
            val to = min(from + 480, signal.len)

            t.feed(signal[from..<to])
            from = to

            t.note() match
                Some(n) ->
                    assert_eq(n.midi, 64, f"seed ${seed} showed MIDI ${n.midi} rather than E4")
                    assert(n.cents.abs() < 30.0, f"E4 off by ${n.cents} cents")
                    shown += 1
                None -> ()

        assert(shown > 50, f"seed ${seed} showed E4 for only ${shown} chunks")

// ## Settings changed while the stream runs
//
// Each test below feeds two pipelines the same samples, changes one setting on one of them partway
// through, and shows the two disagree from the next window on — so a pipeline that ignored the
// setting would fail it.

private same(a: Settings, b: Settings) -> bool =
    a.cutoff == b.cutoff && a.threshold == b.threshold && a.clarity == b.clarity &&
    a.tolerance == b.tolerance && a.median == b.median && a.hold == b.hold && a.gate == b.gate

@test
the_default_settings_are_the_ones_the_tuner_shipped_with()
    val d = settings()

    assert(d.cutoff == 65.0 && d.threshold == f32(0.2) && d.clarity == f32(0.8), "cutoff, threshold, clarity")
    assert(d.tolerance == f32(0.1) && d.median == 5 && d.hold == 1.0 && d.gate == f32(0.001),
           "tolerance, median, hold, gate")
    assert(same(pipeline().current(), d), "a new pipeline runs on them")
    assert(same(controls().settings(), d), "and so do new controls")

// What the recording reads after its first `skip` samples, with the settings changed at that point.
private watch_after(skip: usize, change: Settings) -> Showing
    val r = recording()
    var t = pipeline()

    t.feed(r[0..<skip])
    t.adjust(change)
    watch(&t, r[skip..<r.len])
end watch_after

// Where the string is sounding in the recording: after the pluck, before most of it.
private const PLUCKED: usize = 24000

@test
raising_the_clarity_mid_stream_keeps_the_frames_it_no_longer_trusts_out()
    var strict = settings()
    strict.clarity = 0.99

    val before = watch_after(PLUCKED, settings())
    val after = watch_after(PLUCKED, strict)

    assert(before.e2 > 100, f"E2 for ${before.e2} chunks under the defaults")
    assert(after.e2 * 4 < before.e2, f"E2 for ${after.e2} chunks at a clarity of 0.99, ${before.e2} without")

// How many windows of the recording after `skip` read any period at all, before the clarity cut.
private periods_after(skip: usize, change: Settings) -> usize
    val r = recording()
    var t = pipeline()
    var found: usize = 0

    t.feed(r[0..<skip])
    t.adjust(change)

    var from = skip

    while from + HOP <= r.len
        t.feed(r[from..<from + HOP])
        from += HOP

        if t.last().is_some() then found += 1

    found
end periods_after

@test
lowering_the_threshold_mid_stream_finds_fewer_periods()
    var strict = settings()
    strict.threshold = 0.05

    val before = periods_after(PLUCKED, settings())
    val after = periods_after(PLUCKED, strict)

    assert(after * 2 < before, f"$after windows with a period at a threshold of 0.05, $before at 0.2")

@test
the_clarity_cut_comes_after_the_raw_reading()
    // The raw reading is what the detector answered, so a stricter clarity drops frames without
    // changing which ones had a period.
    var strict = settings()
    strict.clarity = 0.99

    assert_eq(periods_after(PLUCKED, strict), periods_after(PLUCKED, settings()), "the same windows had a period")

@test
a_tolerance_of_zero_mid_stream_brings_back_the_subharmonic()
    // The A string's period is three of E4's, and without the correction the noisy frames read it.
    var off = settings()
    off.tolerance = 0.0

    var low_on: usize = 0
    var low_off: usize = 0

    for seed in 1..<5
        val signal = ringing_e4(seconds(1.0), seed)
        var corrected = pipeline()
        var uncorrected = pipeline()

        corrected.feed(signal[0..<WINDOW])
        uncorrected.feed(signal[0..<WINDOW])
        uncorrected.adjust(off)

        var from = WINDOW

        while from + HOP <= signal.len
            corrected.feed(signal[from..<from + HOP])
            uncorrected.feed(signal[from..<from + HOP])
            from += HOP

            if corrected.last().map(e -> e.frequency < 200.0).unwrap_or(false) then low_on += 1
            if uncorrected.last().map(e -> e.frequency < 200.0).unwrap_or(false) then low_off += 1

    assert_eq(low_on, 0, "the correction reads no window an octave and a fifth low")
    assert(low_off > 0, "with no correction, a window reads the A string's period")

@test
a_median_of_one_mid_stream_shows_the_burst_the_median_of_five_rejected()
    var single = settings()
    single.median = 1

    var t = pipeline()
    var at: usize = 0
    var shown_g = false

    for hop in 0..<30
        if hop == 10 then t.adjust(single)

        val f = if hop == 20 || hop == 21 then 196.0 else 110.0
        t.feed(tone(f, HOP, at))
        at += HOP

        if hop >= 4 && hop < 20 then assert_eq(heard(t).label(), "A2", f"hop $hop")
        if t.note().map(n -> n.label()) == Some("G3") then shown_g = true

    assert(shown_g, "the window that heard only the G is shown, there being nothing to outvote it")

@test
shortening_the_median_keeps_the_latest_readings()
    var s = smoother()
    for f in [110.0, 110.0, 110.0, 500.0, 500.0] do s.push(f32(f))

    assert(s.value() == Some(f32(110.0)), "three of five are 110")

    s.resize(3)
    assert(s.value() == Some(f32(500.0)), f"the latest three are 110, 500, 500: ${s.value()}")

    s.resize(9)
    s.push(f32(500.0))
    assert(s.value() == Some(f32(500.0)), "growing keeps what was held")

@test
a_hold_of_zero_clears_at_the_first_window_that_hears_nothing()
    var none = settings()
    none.hold = 0.0

    var held = pipeline()
    var cleared = pipeline()

    held.feed(tone(110.0, seconds(0.5)))
    held.feed(silence(WINDOW + HOP))
    cleared.feed(tone(110.0, seconds(0.5)))
    cleared.feed(silence(WINDOW + HOP))

    // Every window read so far has had some of the tone in it, and both still show it.
    assert(held.pitch().is_some() && cleared.pitch().is_some(), "both show A2 until the change")

    cleared.adjust(none)
    held.feed(silence(HOP + 1))
    cleared.feed(silence(HOP + 1))

    assert(held.pitch().is_some(), "the default hold keeps A2 up")
    assert(cleared.pitch().is_none(), "no hold clears it at the next window")

@test
a_longer_hold_mid_stream_keeps_the_note_past_a_second()
    var longer = settings()
    longer.hold = 2.5

    var t = pipeline()
    t.feed(tone(110.0, seconds(0.5)))
    t.adjust(longer)
    t.feed(silence(seconds(2.0)))

    assert(t.note().map(n -> n.label()) == Some("A2"), "held 2 s after the string stopped")

    t.feed(silence(seconds(0.7)))
    assert(t.pitch().is_none(), "cleared 2.7 s after")

@test
raising_the_cutoff_mid_stream_takes_the_low_e_fundamental_out_of_the_level()
    var high = settings()
    high.cutoff = 150.0

    var t = pipeline()
    var at = seconds(0.5)
    t.feed(tone(82.4069, at))

    val before = t.level()

    t.adjust(high)
    t.feed(tone(82.4069, HOP, at))

    val next = t.level()

    t.feed(tone(82.4069, HOP, at + HOP))

    val after = t.level()

    assert(next < before - 1.0, f"the next window is quieter: $before dB, then $next")
    assert(after < before - 4.0, f"a window wholly through the new filter is $after dB, against $before")

@test
a_new_filter_glitches_a_steady_reading_for_at_most_one_hop()
    for cutoff in [20.0, 150.0]
        var change = settings()
        change.cutoff = cutoff

        var t = pipeline()
        var at: usize = 0
        var off: usize = 0

        for hop in 0..<40
            if hop == 15 then t.adjust(change)

            t.feed(tone(329.6276, HOP, at))
            at += HOP

            if hop >= 6
                val n = heard(t)

                if n.midi != 64 || n.cents.abs() > 1.0 then off += 1

        assert(off <= 1, f"a cutoff of $cutoff put the reading off for $off hops")

@test
raising_the_gate_mid_stream_silences_a_quiet_tone()
    val n = seconds(0.5)
    var quiet = tone(110.0, n + HOP)
    for j in 0..<quiet.len do quiet[j] *= 0.02

    var t = pipeline()
    t.feed(quiet[0..<n])
    assert(t.last().is_some(), f"a tone at ${t.level()} dB is heard under the default gate")

    var deaf = settings()
    deaf.gate = from_dbfs(-30.0)

    t.adjust(deaf)
    t.feed(quiet[n..<n + HOP])
    assert(t.last().is_none(), "the next window is silence under a gate at -30 dB")

@test
resetting_restores_the_defaults()
    val c = controls()

    c.cutoff.set(140.0)
    c.threshold.set(0.4)
    c.clarity.set(0.6)
    c.tolerance.set(0.0)
    c.median.set(9)
    c.hold.set(2.5)
    c.gate.set(-30.0)
    assert(!same(c.settings(), settings()), "the controls moved")

    var t = pipeline()
    t.adjust(c.settings())

    c.reset()
    assert(same(c.settings(), settings()), "every control is back")

    t.adjust(c.settings())
    assert(same(t.current(), settings()), "and so is the pipeline")

    // And it behaves as a new one does: the burst a median of five rejects is rejected again.
    var at: usize = 0

    for hop in 0..<30
        val f = if hop == 20 || hop == 21 then 196.0 else 110.0
        t.feed(tone(f, HOP, at))
        at += HOP

        if hop >= 4 then assert_eq(heard(t).label(), "A2", f"hop $hop")

@test
the_gate_in_decibels_round_trips_at_both_ends()
    assert((from_dbfs(GATE_LEAST_DB) - f32(0.0001)).abs() < f32(1e-9), f"-80 dB is ${from_dbfs(GATE_LEAST_DB)}")
    assert((dbfs(from_dbfs(GATE_LEAST_DB)) - GATE_LEAST_DB).abs() < 1e-4, "and back")
    assert((from_dbfs(GATE_MOST_DB) - f32(0.0501187)).abs() < f32(1e-6), f"-26 dB is ${from_dbfs(GATE_MOST_DB)}")
    assert((dbfs(from_dbfs(GATE_MOST_DB)) - GATE_MOST_DB).abs() < 1e-4, "and back")
    assert(from_dbfs(GATE_DB) == GATE, "the default is the detector's own gate, exactly")
    assert(dbfs(0.0) == -120.0, "silence is a number")
