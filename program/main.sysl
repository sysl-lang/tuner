// A chromatic tuner: the note nearest what the microphone hears, and how far off it is.
//
// **The listening is `tuner.Pipeline`'s, and this file only moves samples and draws.** Every frame
// drains what the microphone has recorded into the pipeline, and the screen is rebuilt from what the
// pipeline answers. The same file is the Android program — `SDL_main`, which `SDLActivity` looks up
// in `libmain.so` — and the desktop one, whose top level below is the entry point `sysl build-c`
// leaves out of the archive.
//
// **`TUNER_TONE=110.5` replaces the microphone with a synthesized tone at that frequency**, so the
// program can be looked at on a machine where nobody is there to answer a permission prompt, and
// **`TUNER_DETECTION=open` starts with the Detection settings showing**, for the same reason.
//
// **The Detection settings are not kept**: every launch starts from the defaults. What the screen
// looks like is `tuner.screen`'s.

import sh.sysl.ui_sdl.{app, run}
import sh.sysl.sdl3.{AudioStream, init_audio, open_recording_stream, error}
import sysl.env
import sysl.math.Float
import sysl.text.{Search, parse_real}
import tuner.{Model, Pipeline, RATE, hundredths, model, pipeline, screen, tenths}

// What the window is asked for: taller than wide, so a phone starts upright.
const WANTED_W: int = 400
const WANTED_H: int = 800

// Frames drawn before the microphone is opened. On Android the open shows the permission prompt and
// waits for the answer, so the tuner's own screen is up behind it first.
const SETTLE: int = 3

// Where the samples come from.
enum Source
    // Not opened yet: the first few frames.
    Waiting

    Microphone(stream: &AudioStream)

    // A tone synthesized at this frequency, and the sample the next chunk starts at.
    Tone(frequency: real, at: usize)

    // The microphone would not open, and SDL's reason.
    Refused(why: string)
end Source

// What only the frame loop touches.
struct Listener
    source: Source
    pipeline: Pipeline
    scratch: []f32
    frames: int

// The synthesized tone, when the environment asks for one.
private wanted_tone() -> Option[real]
    val s = env.get("TUNER_TONE")?

    parse_real(s).ok()
end wanted_tone

// The first frames wait; then the microphone is opened, or the tone started.
private open(l: &Listener, m: &Model)
    wanted_tone() match
        Some(f) ->
            l.source = Tone(f, 0)
            m.status.set(s"a test tone at $f Hz")
        None ->
            val opened = if init_audio() then open_recording_stream(RATE) else None

            opened match
                Some(stream) ->
                    l.source = Microphone(stream)
                    m.status.set("listening")
                None -> refuse(l, m, error())
end open

private refuse(l: &Listener, m: &Model, why: string)
    l.source = Refused(why)

    val permission = why.contains("permission")

    m.status.set(if permission then "no microphone permission" else s"no microphone: $why")
end refuse

// Everything recorded since the last frame, into the pipeline.
private drain(l: &Listener, stream: &AudioStream)
    loop
        stream.read(l.scratch) match
            Some(n) if n > 0 -> l.pipeline.feed(l.scratch[0..<n])
            _ -> break
end drain

// `dt` seconds of the test tone: three harmonics, as a string has.
private synthesize(l: &Listener, f: real, from: usize, dt: real) -> usize
    val n = usize(dt * real(RATE))
    val step = 2.0 * real.pi() * f / real(RATE)
    var chunk: []f32 = [0.0; n]

    for j in 0..<n
        val t = step * real(from + j)
        chunk[j] = f32(0.3 * t.sin() + 0.15 * (2.0 * t).sin() + 0.08 * (3.0 * t).sin())

    l.pipeline.feed(chunk)
    from + n
end synthesize

// Once a frame, on the loop's thread.
private listen(l: &Listener, m: &Model, dt: real)
    l.frames += 1
    l.pipeline.adjust(m.controls.settings())

    l.source match
        Waiting -> if l.frames >= SETTLE then open(l, m)
        Microphone(stream) -> drain(l, stream)
        Tone(f, at) -> l.source = Tone(f, synthesize(l, f, at, dt))
        Refused(_) -> return

    l.pipeline.tune(real(m.a4.read()))

    val heard = l.pipeline.pitch().unwrap_or(0.0)
    val midi = l.pipeline.note().map(n -> n.midi).unwrap_or(0)

    if midi != m.midi.read() then m.midi.set(midi)

    if heard != m.frequency.read() then m.frequency.set(heard)

    // Only while they are on show, so that a closed section rebuilds the screen no more often than
    // the tuner did without it.
    if m.open.read() then report(l, m)
end listen

// The last window's level and raw reading, into the signals the Detection section shows.
private report(l: &Listener, m: &Model)
    val level = int(l.pipeline.level().round())

    if level != m.level.read() then m.level.set(level)

    val raw = l.pipeline.last() match
        Some(e) ->
            val dropped = if e.clarity < l.pipeline.current().clarity then " · dropped" else ""

            s"last window ${tenths(real(e.frequency))} Hz · clarity ${hundredths(real(e.clarity))}$dropped"
        None -> "last window: no period"

    if raw != m.raw.read() then m.raw.set(raw)
end report

start() -> i32
    val m = model(env.get("TUNER_DETECTION") == Some("open"))
    val l: &Listener = Listener(Waiting, pipeline(), [0.0; 4096], 0)

    run(app("Tuner", () -> screen(m), () -> 0x12141C, WANTED_W, WANTED_H, on_frame = dt -> listen(l, m, dt)))
    0
end start

@export("SDL_main")
sdl_main(argc: i32, argv: **u8) -> i32 = start()

start()
