// A chromatic tuner: the note nearest what the microphone hears, and how far off it is.
//
// **The listening is `tuner.Pipeline`'s, and this file only moves samples and draws.** Every frame
// drains what the microphone has recorded into the pipeline, and the screen is rebuilt from what the
// pipeline answers. The same file is the Android program — `SDL_main`, which `SDLActivity` looks up
// in `libmain.so` — and the desktop one, whose top level below is the entry point `sysl build-c`
// leaves out of the archive.
//
// **`TUNER_TONE=110.5` replaces the microphone with a synthesized tone at that frequency**, so the
// program can be looked at on a machine where nobody is there to answer a permission prompt, and
// **`TUNER_DETECTION=open` starts with the Detection settings showing**, for the same reason.
//
// **The Detection settings are not kept**: every launch starts from the defaults.

import sh.sysl.ui.*
import sh.sysl.ui_sdl.{app, run}
import sh.sysl.sdl3.{AudioStream, init_audio, open_recording_stream, error}
import sh.sysl.pitch.{Note, cents_from, frequency_of}
import sysl.env
import sysl.math.{Float, max, min}
import sysl.text.{Search, parse_real}
import tuner.{Controls, GATE_LEAST_DB, GATE_MOST_DB, Pipeline, RATE, controls, dbfs, pipeline}

// What the window is asked for: taller than wide, so a phone starts upright.
const WANTED_W: int = 400
const WANTED_H: int = 800

// How wide the meter is drawn, in the toolkit's points.
const METER_W: int = 320

// A setting's row: its name, its slider and its value, which together fill the 360 points inside the
// screen's padding. The name and the value are given widths of their own so that a value changing
// length never moves the slider under a finger.
const NAME_W: int = 100
const SLIDER_W: int = 172
const VALUE_W: int = 64
const ROW_H: int = 22

// Frames drawn before the microphone is opened. On Android the open shows the permission prompt and
// waits for the answer, so the tuner's own screen is up behind it first.
const SETTLE: int = 3

// Where the samples come from.
enum Source
    // Not opened yet: the first few frames.
    Waiting

    Microphone(stream: &AudioStream)

    // A tone synthesized at this frequency, and the sample the next chunk starts at.
    Tone(frequency: real, at: usize)

    // The microphone would not open, and SDL's reason.
    Refused(why: string)
end Source

// What the screen reads. Signals, so that writing one rebuilds the tree.
struct Model
    frequency: &Signal[real]       // the pitch heard, 0.0 for none
    midi: &Signal[int]             // the note on show, which is not always the nearest one
    status: &Signal[string]
    a4: &Signal[int]

    // The Detection section: whether it is open, what its sliders hold, and what it reports — the
    // last window's level in dBFS and its reading before the median.
    open: &Signal[bool]
    controls: Controls
    level: &Signal[int]
    raw: &Signal[string]

// What only the frame loop touches.
struct Listener
    source: Source
    pipeline: Pipeline
    scratch: []f32
    frames: int

// The synthesized tone, when the environment asks for one.
private wanted_tone() -> Option[real]
    val s = env.get("TUNER_TONE")?

    parse_real(s).ok()
end wanted_tone

// The first frames wait; then the microphone is opened, or the tone started.
private open(l: &Listener, m: &Model)
    wanted_tone() match
        Some(f) ->
            l.source = Tone(f, 0)
            m.status.set(s"a test tone at $f Hz")
        None ->
            val opened = if init_audio() then open_recording_stream(RATE) else None

            opened match
                Some(stream) ->
                    l.source = Microphone(stream)
                    m.status.set("listening")
                None -> refuse(l, m, error())
end open

private refuse(l: &Listener, m: &Model, why: string)
    l.source = Refused(why)

    val permission = why.contains("permission")

    m.status.set(if permission then "no microphone permission" else s"no microphone: $why")
end refuse

// Everything recorded since the last frame, into the pipeline.
private drain(l: &Listener, stream: &AudioStream)
    loop
        stream.read(l.scratch) match
            Some(n) if n > 0 -> l.pipeline.feed(l.scratch[0..<n])
            _ -> break
end drain

// `dt` seconds of the test tone: three harmonics, as a string has.
private synthesize(l: &Listener, f: real, from: usize, dt: real) -> usize
    val n = usize(dt * real(RATE))
    val step = 2.0 * real.pi() * f / real(RATE)
    var chunk: []f32 = [0.0; n]

    for j in 0..<n
        val t = step * real(from + j)
        chunk[j] = f32(0.3 * t.sin() + 0.15 * (2.0 * t).sin() + 0.08 * (3.0 * t).sin())

    l.pipeline.feed(chunk)
    from + n
end synthesize

// Once a frame, on the loop's thread.
private listen(l: &Listener, m: &Model, dt: real)
    l.frames += 1
    l.pipeline.adjust(m.controls.settings())

    l.source match
        Waiting -> if l.frames >= SETTLE then open(l, m)
        Microphone(stream) -> drain(l, stream)
        Tone(f, at) -> l.source = Tone(f, synthesize(l, f, at, dt))
        Refused(_) -> return

    l.pipeline.tune(real(m.a4.read()))

    val heard = l.pipeline.pitch().unwrap_or(0.0)
    val midi = l.pipeline.note().map(n -> n.midi).unwrap_or(0)

    if midi != m.midi.read() then m.midi.set(midi)

    if heard != m.frequency.read() then m.frequency.set(heard)

    // Only while they are on show, so that a closed section rebuilds the screen no more often than
    // the tuner did without it.
    if m.open.read() then report(l, m)
end listen

// The last window's level and raw reading, into the signals the Detection section shows.
private report(l: &Listener, m: &Model)
    val level = int(l.pipeline.level().round())

    if level != m.level.read() then m.level.set(level)

    val raw = l.pipeline.last() match
        Some(e) ->
            val dropped = if e.clarity < l.pipeline.current().clarity then " · dropped" else ""

            s"last window ${tenths(real(e.frequency))} Hz · clarity ${hundredths(real(e.clarity))}$dropped"
        None -> "last window: no period"

    if raw != m.raw.read() then m.raw.set(raw)
end report

private signed(cents: real) -> string
    val r = int(cents.round())

    if r > 0 then s"+$r" else s"$r"
end signed

// One decimal place.
private tenths(x: real) -> string
    val t = int((x * 10.0).round())

    s"${t / 10}.${t % 10}"
end tenths

// Two decimal places, of a value that is not negative.
private hundredths(x: real) -> string
    val h = int((x * 100.0).round())
    val pad = if h % 100 < 10 then "0" else ""

    s"${h / 100}.$pad${h % 100}"
end hundredths

private centred(v: &View) -> &View = row([spacer(), v, spacer()])

private reading(n: Note[real], f: real) -> &View
    val name = row([text(n.name()).font_size(150.0), text(s"${n.octave()}").text_style(TextStyle.Title)], 4)

    column(spacing = 18):
        centred(name)
        centred(meter(n.cents, -50.0, 50.0, METER_W, 5.0))
        centred(text(s"${signed(n.cents)} cents · ${tenths(f)} Hz").text_style(TextStyle.Caption))
end reading

private quiet() -> &View
    column(spacing = 18):
        centred(text("–").font_size(150.0).foreground(0x5A5F6E))
        // No band: with nothing heard, nothing is in tune.
        centred(meter(0.0, -50.0, 50.0, METER_W, role = Role.Secondary))
        centred(text(" ").text_style(TextStyle.Caption))
end quiet

private step_a4(m: &Model, by: int) -> &Fn() -> unit =
    () -> m.a4.set(max(430, min(450, m.a4.read() + by)))

// One setting: its name, the control, and what it is set to.
private setting(name: string, control: &View, value: string) -> &View
    row([text(name).text_style(TextStyle.Caption).frame(NAME_W, ROW_H), control,
         text(value).text_style(TextStyle.Caption).frame(VALUE_W, ROW_H)], 12)

// The detection's settings, what the last window heard, and the way back to the defaults.
private detection(m: &Model) -> &View
    val c = m.controls
    val gate = c.gate.read()

    column(spacing = 6):
        setting("High-pass", slider(c.cutoff, 20.0, 150.0, SLIDER_W, step = 5.0),
                s"${int(c.cutoff.read().round())} Hz")
        setting("YIN threshold", slider(c.threshold, 0.05, 0.5, SLIDER_W, step = 0.01),
                hundredths(c.threshold.read()))
        setting("Min clarity", slider(c.clarity, 0.5, 0.99, SLIDER_W, step = 0.01), hundredths(c.clarity.read()))
        setting("Subharmonic", slider(c.tolerance, 0.0, 0.4, SLIDER_W, step = 0.01),
                if c.tolerance.read() > 0.0 then hundredths(c.tolerance.read()) else "off")
        setting("Smoothing", slider(c.median, 1, 9, SLIDER_W, step = 2), s"${c.median.read()} reads")
        setting("Hold", slider(c.hold, 0.0, 3.0, SLIDER_W, step = 0.1), s"${tenths(c.hold.read())} s")
        setting("Silence gate", slider(c.gate, GATE_LEAST_DB, GATE_MOST_DB, SLIDER_W, step = 1.0),
                s"${int(gate.round())} dB")
        // The gate is the meter's target mark, so the room's level and the gate read on one scale.
        setting("Input", meter(real(m.level.read()), -80.0, 0.0, SLIDER_W, target = gate, role = Role.Secondary),
                s"${m.level.read()} dB")
        centred(text(m.raw.read()).text_style(TextStyle.Caption))
end detection

// The section's header, with the reset beside it while the section is open — on a row of its own
// it would push the A4 buttons off a 800-point window.
private toggle(m: &Model) -> &View
    // A plus and a minus rather than triangles: Roboto, which Android draws with, has none of the
    // triangles (U+25B8, U+25BE, U+25BA, U+25BC), and these two the A4 buttons already show.
    val open = m.open.read()
    val header = button(if open then "Detection −" else "Detection +", () -> m.open.set(!open), Role.Secondary)

    if open then centred(row([header, button("Reset to defaults", () -> m.controls.reset(), Role.Secondary)], 12))
    else centred(header)
end toggle

// The whole screen, rebuilt whenever a signal is written.
screen(m: &Model) -> &View
    val f = m.frequency.read()
    val shown = if f > 0.0 then Some(shown_note(m.midi.read(), f, real(m.a4.read()))) else None

    val status = shown match
        Some(_) -> m.status.read()
        None -> if m.status.read() == "listening" then "play a string" else m.status.read()

    val body = column(spacing = 28):
        centred(text("Tuner").text_style(TextStyle.Title))
        spacer()
        shown match
            Some(n) -> reading(n, f)
            None -> quiet()
        centred(text(status))
        if m.open.read() then column([toggle(m), detection(m)], 8) else toggle(m)
        spacer()
        centred(row([button("−", step_a4(m, -1), Role.Secondary),
                     text(s"A4 = ${m.a4.read()} Hz").padding(6),
                     button("+", step_a4(m, 1), Role.Secondary)], 10))

    body.padding(20).restyle(_ -> dark())
end screen

// The note the pipeline is showing, with the cents measured from it rather than from whichever note
// happens to be nearest.
private shown_note(midi: int, f: real, a4: real) -> Note[real] = Note(midi, cents_from(f, frequency_of(midi, a4)))

start() -> i32
    val open = env.get("TUNER_DETECTION") == Some("open")
    val m: &Model = Model(signal(0.0), signal(0), signal("starting"), signal(440), signal(open), controls(),
                          signal(-120), signal("last window: none yet"))
    val l: &Listener = Listener(Waiting, pipeline(), [0.0; 4096], 0)

    run(app("Tuner", () -> screen(m), () -> 0x12141C, WANTED_W, WANTED_H, on_frame = dt -> listen(l, m, dt)))
    0
end start

@export("SDL_main")
sdl_main(argc: i32, argv: **u8) -> i32 = start()

start()
